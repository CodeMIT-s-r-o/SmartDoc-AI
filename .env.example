# Local development only. `make up` copies this file to .env on first run. Never commit .env.

# Needed for the OpenAI spike (`make spike`), ingestion and chat. Use the smartdoc-dev project key.
OPENAI_API_KEY=

# Shared secret between api and ai (any random string of at least 16 characters).
INTERNAL_TOKEN=local-dev-internal-token-change-me

# Local Postgres container. Passwords apply only when the volume is first created (`make reset-db`).
POSTGRES_PASSWORD=postgres
DB_OWNER_PASSWORD=smartdoc_owner_dev
DB_APP_PASSWORD=smartdoc_app_dev
# Change if port 5432 is already taken on your machine.
DB_PORT=5432

# Daily AI spend across all users (USD); each user also has their own limit (default $0.25,
# change with `make budget`).
GLOBAL_DAILY_CAP_USD=2
