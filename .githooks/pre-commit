#!/usr/bin/env bash
# Refuse a commit that adds a secret (gitleaks over the staged changes, values redacted).
# Enabled by `make hooks`; bypass once with `git commit --no-verify` only for a reviewed false
# positive, and then add its fingerprint to .gitleaksignore.
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, secrets were NOT checked (brew install gitleaks)" >&2
  exit 0
fi
exec gitleaks git --pre-commit --staged --redact --no-banner --verbose
